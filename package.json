{
  "name": "nanocode-ts",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && npm run build:ts",
    "build:ts": "tsc -p tsconfig.build.json && tsc -p tsconfig.cloudflare.build.json && node scripts/zyzz.mjs && node scripts/pyodide.mjs",
    "check": "vp check --fix",
    "check:types": "tsc --noEmit && tsc --noEmit -p tsconfig.vercel.json && tsc --noEmit -p tsconfig.cloudflare.json && tsc --noEmit -p tsconfig.test.json",
    "prepare": "node scripts/prepare.mjs",
    "test": "vp test run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vercel": {
      "types": "./dist/vercel/index.d.ts",
      "default": "./dist/vercel/index.js"
    },
    "./vercel/transport": {
      "types": "./dist/vercel/transport.d.ts",
      "default": "./dist/vercel/transport.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "default": "./dist/cloudflare/index.js"
    },
    "./cloudflare/transport": {
      "types": "./dist/cloudflare/transport.d.ts",
      "default": "./dist/cloudflare/transport.js"
    },
    "./cloudflare/python": {
      "types": "./dist/cloudflare/python.d.ts",
      "default": "./dist/cloudflare/python.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/skin": {
      "types": "./dist/react/skin.d.ts",
      "default": "./dist/react/skin.js"
    },
    "./react/site": {
      "types": "./dist/react/site.d.ts",
      "default": "./dist/react/site.js"
    },
    "./react/theme": {
      "types": "./dist/react/theme.d.ts",
      "default": "./dist/react/theme.js"
    },
    "./react/themes": {
      "types": "./dist/react/themes.d.ts",
      "default": "./dist/react/themes.js"
    },
    "./react/playground": {
      "types": "./dist/react/playground.d.ts",
      "default": "./dist/react/playground.js"
    },
    "./react/clones": {
      "types": "./dist/react/clones.d.ts",
      "default": "./dist/react/clones.js"
    },
    "./react/zyzz.css": "./dist/react/zyzz.css",
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "default": "./dist/highlight.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "default": "./dist/models.js"
    },
    "./bash": {
      "types": "./dist/bash/index.d.ts",
      "default": "./dist/bash/index.js"
    },
    "./machines": {
      "types": "./dist/machines/index.d.ts",
      "default": "./dist/machines/index.js"
    },
    "./machines/server": {
      "types": "./dist/machines/account.d.ts",
      "default": "./dist/machines/account.js"
    },
    "./machines/react": {
      "types": "./dist/react/machines.d.ts",
      "default": "./dist/react/machines.js"
    },
    "./machines/cloudflare": {
      "types": "./dist/machines/cloudflare/index.d.ts",
      "default": "./dist/machines/cloudflare/index.js"
    },
    "./machines/vercel": {
      "types": "./dist/machines/vercel.d.ts",
      "default": "./dist/machines/vercel.js"
    },
    "./sandbox/cloudflare": {
      "types": "./dist/sandbox/cloudflare.d.ts",
      "default": "./dist/sandbox/cloudflare.js"
    },
    "./sandbox/vercel": {
      "types": "./dist/sandbox/vercel.d.ts",
      "default": "./dist/sandbox/vercel.js"
    },
    "./nanocode_wasm.wasm": "./dist/nanocode_wasm.wasm",
    "./interpreter.wasm": "./dist/interpreter.wasm",
    "./pyodide-modules": {
      "types": "./dist/pyodide/modules.d.ts",
      "default": "./dist/pyodide/modules.js"
    }
  },
  "dependencies": {
    "accounts": "0.21.0",
    "mppx": "0.13.6",
    "ox": "0.14.56",
    "streamdown": "2.7.1",
    "undici": "7.30.1",
    "viem": "2.57.7",
    "zyzz": "0.0.40"
  },
  "peerDependencies": {
    "@pierre/highlights": "^0.2.0",
    "@vercel/oidc": "^3.2.0",
    "@vercel/sandbox": "^3.9.0",
    "durable-harness": "0.0.1-beta.6",
    "pyodide": ">=0.28.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@pierre/highlights": {
      "optional": true
    },
    "@vercel/oidc": {
      "optional": true
    },
    "@vercel/sandbox": {
      "optional": true
    },
    "durable-harness": {
      "optional": true
    },
    "pyodide": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@pierre/highlights": "0.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@vercel/oidc": "3.2.0",
    "@vercel/sandbox": "3.9.0",
    "durable-harness": "0.0.1-beta.6",
    "pyodide": "^314.0.7",
    "typescript": "6.0.2",
    "vite-plus": "0.2.4"
  }
}
