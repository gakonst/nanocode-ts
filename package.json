{
  "name": "nanocode-ts",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.vercel.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vercel": {
      "types": "./dist/vercel/index.d.ts",
      "default": "./dist/vercel/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "default": "./dist/cloudflare/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/styles.css": "./dist/react/styles.css",
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "default": "./dist/highlight.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "default": "./dist/models.js"
    },
    "./bash": {
      "types": "./dist/bash/index.d.ts",
      "default": "./dist/bash/index.js"
    },
    "./quickjs": {
      "types": "./dist/quickjs/index.d.ts",
      "default": "./dist/quickjs/index.js"
    },
    "./nanocode_wasm.wasm": "./dist/nanocode_wasm.wasm",
    "./quickjs.wasm": "./dist/quickjs.wasm"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "quickjs-emscripten-core": "0.32.0"
  },
  "peerDependencies": {
    "@pierre/highlights": "^0.2.0",
    "@vercel/oidc": "^3.2.0",
    "durable-harness": "0.0.1-beta.6",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@pierre/highlights": {
      "optional": true
    },
    "@vercel/oidc": {
      "optional": true
    },
    "durable-harness": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pierre/highlights": "0.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@vercel/oidc": "3.2.0",
    "durable-harness": "0.0.1-beta.6",
    "typescript": "6.0.2"
  }
}
