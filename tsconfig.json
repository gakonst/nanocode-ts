{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": [],
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/*.ts",
    "src/machines/*.ts",
    "src/cloudflare/sql.ts",
    "src/cloudflare/transport.ts",
    "src/vercel/transport.ts",
    "src/bash/*.ts",
    "src/bash/commands/*.ts",
    "src/sandbox/cloudflare.ts",
    "src/sandbox/shell.ts",
    "src/react/*.ts",
    "src/react/*.tsx"
  ],
  "exclude": ["src/machines/vercel.ts", "src/**/*.test.ts"]
}
