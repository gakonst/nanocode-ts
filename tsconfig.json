{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": [],
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/*.ts",
    "src/bash/*.ts",
    "src/bash/internal/*.ts",
    "src/bash/internal/commands/*.ts",
    "src/client/*.ts",
    "src/client/internal/*.ts",
    "src/cloudflare/Sql.ts",
    "src/cloudflare/Transport.ts",
    "src/internal/*.ts",
    "src/machines/*.ts",
    "src/react/*.ts",
    "src/react/*.tsx",
    "src/sandbox/cloudflare.ts",
    "src/sandbox/Container.ts",
    "src/sandbox/internal/*.ts",
    "src/vercel/Transport.ts"
  ],
  "exclude": ["src/machines/vercel.ts"]
}
