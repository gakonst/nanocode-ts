{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/cloudflare/App.ts",
    "src/cloudflare/Forward.ts",
    "src/cloudflare/Gateway.ts",
    "src/cloudflare/index.ts",
    "src/cloudflare/internal/**",
    "src/cloudflare/Limit.ts",
    "src/cloudflare/Listings.ts",
    "src/cloudflare/Plans.ts",
    "src/cloudflare/python.ts",
    "src/cloudflare/Relay.ts",
    "src/cloudflare/wasm.d.ts",
    "src/machines/cloudflare/**",
    "src/**/*.test.ts"
  ]
}
